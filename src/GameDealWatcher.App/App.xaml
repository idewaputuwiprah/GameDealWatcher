<Application x:Class="GameDealWatcher.App.App"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:converters="using:GameDealWatcher.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:StringFormatConverter x:Key="StringFormatConverter"/>
            <converters:PriceConverter x:Key="PriceConverter"/>
            <converters:DiscountVisibilityConverter x:Key="DiscountVisibilityConverter"/>
            <converters:DiscountLabelConverter x:Key="DiscountLabelConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:ImageUrlConverter x:Key="ImageUrlConverter"/>

            <!-- Steam-inspired dark palette -->
            <SolidColorBrush x:Key="SteamAppBackgroundBrush" Color="#1B2838"/>
            <SolidColorBrush x:Key="SteamPanelBackgroundBrush" Color="#171A21"/>
            <SolidColorBrush x:Key="SteamCardBackgroundBrush" Color="#16202D"/>
            <SolidColorBrush x:Key="SteamCardFooterBackgroundBrush" Color="#232F3D"/>
            <SolidColorBrush x:Key="SteamAccentBrush" Color="#66C0F4"/>
            <SolidColorBrush x:Key="SteamDiscountBadgeBrush" Color="#4C6B22"/>
            <SolidColorBrush x:Key="SteamDiscountTextBrush" Color="#BEEE11"/>
            <SolidColorBrush x:Key="SteamFreeBadgeBrush" Color="#4C6B22"/>
            <SolidColorBrush x:Key="SteamUpcomingBadgeBrush" Color="#3A3F44"/>
            <SolidColorBrush x:Key="SteamPrimaryTextBrush" Color="#C7D5E0"/>
            <SolidColorBrush x:Key="SteamHeadingTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SteamMutedTextBrush" Color="#8F98A0"/>
            <SolidColorBrush x:Key="SteamDividerBrush" Color="#2A3F5A"/>

            <Style x:Key="SteamNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource SteamPrimaryTextBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>

            <Style x:Key="SteamAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SteamAccentBrush}"/>
                <Setter Property="Foreground" Value="#0B1620"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style x:Key="SteamPageTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SteamHeadingTextBrush}"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
