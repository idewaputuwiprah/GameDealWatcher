<UserControl x:Class="GameDealWatcher.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:GameDealWatcher.Domain.Entities">
    <ListView ItemsSource="{x:Bind ViewModel.Deals}" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:GameDeal">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="5" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ProviderName}" />
                        <TextBlock Text="{x:Bind DiscountPercentage}" />
                        <TextBlock Text="{x:Bind CurrentPrice}" />
                        <TextBlock Text="{x:Bind StoreUrl}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>