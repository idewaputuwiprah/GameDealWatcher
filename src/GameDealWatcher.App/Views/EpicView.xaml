<UserControl x:Class="GameDealWatcher.App.Views.EpicView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:converters="using:GameDealWatcher.App.Converters"
              xmlns:models="using:GameDealWatcher.Domain.Entities"
              xmlns:views="using:GameDealWatcher.App.Views">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource SteamAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Epic Games - Free Games" Style="{StaticResource SteamPageTitleStyle}"/>
            <ComboBox ItemsSource="{x:Bind ViewModel.FilterOptions}" SelectedItem="{x:Bind ViewModel.FilterText, Mode=TwoWay}"
                      Margin="0,12,0,0" Width="200" AutomationProperties.AutomationId="EpicFilter"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <GridView ItemsSource="{x:Bind ViewModel.EpicDeals}" SelectionMode="None" IsItemClickEnabled="False" Padding="12"
                      ItemContainerStyle="{StaticResource NonSelectableGridViewItemStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameDeal">
                        <views:GameCard Deal="{x:Bind}"/>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No free games available right now." Foreground="{StaticResource SteamMutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,8,4"/>
                <TextBlock Text="Check back later or try a different filter." Foreground="{StaticResource SteamMutedTextBrush}"
                           HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
