<UserControl x:Class="GameDealWatcher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="12"/>
        <CheckBox Content="Start with Windows" IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" Margin="12" AutomationProperties.AutomationId="SettingsStartWithWindows"/>
        <CheckBox Content="Notify about free Epic games" IsChecked="{x:Bind ViewModel.EpicNotifications, Mode=TwoWay}" Margin="12" AutomationProperties.AutomationId="SettingsEpicNotifications"/>
        <CheckBox Content="Notify about Steam discounts" IsChecked="{x:Bind ViewModel.SteamNotifications, Mode=TwoWay}" Margin="12" AutomationProperties.AutomationId="SettingsSteamNotifications"/>
        <TextBlock Text="Minimum Steam Discount:" Margin="12,5,0,0" Style="{StaticResource BodyTextBlockStyle}"/>
        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MinimumSteamDiscount, Mode=TwoWay}" Margin="12" Width="200" AutomationProperties.AutomationId="SettingsMinDiscount"/>
        <Button Content="Clear Image Cache" Command="{x:Bind ViewModel.ClearCacheCommand}" Margin="12" Width="200" AutomationProperties.AutomationId="BtnClearCache"/>
        <Button Content="Save Settings" Command="{x:Bind ViewModel.SaveCommand}" Margin="12" Width="200" AutomationProperties.AutomationId="BtnSaveSettings"/>
    </StackPanel>
</UserControl>