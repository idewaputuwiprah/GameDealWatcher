<UserControl x:Class="GameDealWatcher.App.Views.SteamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:GameDealWatcher.Domain.Entities">
    <Grid Background="{StaticResource SteamAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Steam Deals" Style="{StaticResource SteamPageTitleStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <TextBlock Text="Min Discount:" VerticalAlignment="Center" Foreground="{StaticResource SteamPrimaryTextBrush}"/>
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MinimumDiscount, Mode=TwoWay}" Width="220" AutomationProperties.AutomationId="SteamMinDiscount"/>
                <TextBlock Text="{x:Bind ViewModel.MinimumDiscount, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource SteamAccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource SteamAccentBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <GridView ItemsSource="{x:Bind ViewModel.SteamDeals}" SelectionMode="None" IsItemClickEnabled="False" Padding="12">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameDeal">
                        <Grid Width="230" Margin="6" Background="{StaticResource SteamCardBackgroundBrush}" CornerRadius="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="110"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Image Source="{x:Bind ImageUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill"/>
                                <Border Background="{StaticResource SteamDiscountBadgeBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Padding="6,3" Margin="6" CornerRadius="2"
                                        Visibility="{x:Bind DiscountPercentage, Converter={StaticResource DiscountVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind DiscountPercentage, Converter={StaticResource DiscountLabelConverter}}"
                                               Foreground="{StaticResource SteamDiscountTextBrush}" FontWeight="Bold" FontSize="13"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Background="{StaticResource SteamCardFooterBackgroundBrush}" Padding="10">
                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource SteamHeadingTextBrush}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Bind OriginalPrice, Converter={StaticResource PriceConverter}}"
                                               Foreground="{StaticResource SteamMutedTextBrush}" TextDecorations="Strikethrough"
                                               Visibility="{x:Bind DiscountPercentage, Converter={StaticResource DiscountVisibilityConverter}}"/>
                                    <TextBlock Text="{x:Bind CurrentPrice, Converter={StaticResource PriceConverter}}"
                                               Foreground="{StaticResource SteamDiscountTextBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
