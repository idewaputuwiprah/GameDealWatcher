<UserControl x:Class="GameDealWatcher.App.Views.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="230" Margin="6" Background="{StaticResource SteamCardBackgroundBrush}" CornerRadius="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image x:Name="CoverImage" Stretch="UniformToFill"/>
            <Border Background="{StaticResource SteamDiscountBadgeBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Padding="6,3" Margin="6" CornerRadius="2"
                    Visibility="{x:Bind DiscountBadgeVisibility(Deal), Mode=OneWay}">
                <TextBlock Text="{x:Bind DiscountText(Deal), Mode=OneWay}"
                           Foreground="{StaticResource SteamDiscountTextBrush}" FontWeight="Bold" FontSize="13"/>
            </Border>
            <Border Background="{StaticResource SteamFreeBadgeBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Padding="6,3" Margin="6" CornerRadius="2"
                    Visibility="{x:Bind FreeBadgeVisibility(Deal), Mode=OneWay}">
                <TextBlock Text="FREE NOW" Foreground="{StaticResource SteamDiscountTextBrush}" FontWeight="Bold" FontSize="12"/>
            </Border>
            <Border Background="{StaticResource SteamUpcomingBadgeBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Padding="6,3" Margin="6" CornerRadius="2"
                    Visibility="{x:Bind UpcomingBadgeVisibility(Deal), Mode=OneWay}">
                <TextBlock Text="UPCOMING" Foreground="{StaticResource SteamPrimaryTextBrush}" FontWeight="Bold" FontSize="12"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Background="{StaticResource SteamCardFooterBackgroundBrush}" Padding="10">
            <TextBlock Text="{x:Bind Deal.Title, Mode=OneWay}" Foreground="{StaticResource SteamHeadingTextBrush}" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind Deal.ProviderName, Mode=OneWay}" Foreground="{StaticResource SteamMutedTextBrush}" FontSize="12" Margin="0,2,0,0"/>
            <TextBlock Text="{x:Bind DateRangeText(Deal), Mode=OneWay}" Visibility="{x:Bind DateRangeVisibility(Deal), Mode=OneWay}"
                       Foreground="{StaticResource SteamMutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="{x:Bind OriginalPriceText(Deal), Mode=OneWay}"
                           Foreground="{StaticResource SteamMutedTextBrush}" TextDecorations="Strikethrough"
                           Visibility="{x:Bind OriginalPriceVisibility(Deal), Mode=OneWay}"/>
                <TextBlock Text="{x:Bind CurrentPriceText(Deal), Mode=OneWay}"
                           Foreground="{StaticResource SteamDiscountTextBrush}" FontWeight="Bold"/>
            </StackPanel>
            <Button Content="Open Store" Click="OpenStore_Click" Style="{StaticResource SteamAccentButtonStyle}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"
                    AutomationProperties.AutomationId="BtnOpenStore"/>
        </StackPanel>
    </Grid>
</UserControl>
